# Скопируйте этот файл в .env.local и подставьте значения своего проекта Supabase
# (Dashboard → Connect или Settings → API Keys).
# Сюда допустим только publishable key: переменные VITE_ попадают в браузер.
# Secret key, service_role и пароль базы данных сюда писать нельзя.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
